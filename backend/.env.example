NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/automotive_marketplace
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179
# Development only: every OTP is this code and it is returned in the response. Leave empty in production.
OTP_DEV_CODE=123456

# SMS for sign-in codes: console (prints, dev only) | msg91 | twilio
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Payment gateway: mock (until you add an adapter in src/providers/payments.ts)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
