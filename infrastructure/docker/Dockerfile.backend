# Shared backend for all portals.
FROM node:22-alpine
WORKDIR /repo
ENV NODE_ENV=production
COPY package.json tsconfig.base.json ./
COPY packages ./packages
COPY backend ./backend
# Install only what the backend workspace needs (plus the shared packages it imports).
RUN npm install --workspace @automotive/backend --include-workspace-root=false --no-audit --no-fund --include=dev
WORKDIR /repo/backend
EXPOSE 4000
USER node
CMD ["npx", "tsx", "src/server.ts"]
