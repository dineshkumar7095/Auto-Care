# Builds ONE portal. Pick it with --build-arg APP=seller-portal (folder name under apps/).
FROM node:22-alpine AS build
ARG APP
ARG VITE_API_URL=http://localhost:4000/api/v1
ARG VITE_USE_MOCKS=false
WORKDIR /repo
COPY package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/${APP} ./apps/${APP}
RUN npm install --workspace @automotive/${APP} --include-workspace-root=false --no-audit --no-fund
ENV VITE_API_URL=${VITE_API_URL} VITE_USE_MOCKS=${VITE_USE_MOCKS}
RUN npm run build -w @automotive/${APP}

FROM nginx:1.27-alpine
ARG APP
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 80
